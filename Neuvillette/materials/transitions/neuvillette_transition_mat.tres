[gd_resource type="ShaderMaterial" load_steps=3 format=3]

[ext_resource type="Texture2D" path="res://Neuvillette/materials/transitions/neuvillette_transition.svg" id="1_transition"]

[sub_resource type="Shader" id="Shader_neuvillette_transition"]
code = "shader_type canvas_item;

uniform sampler2D transitionTex;
uniform float threshold : hint_range(0,1);

void fragment() {
    float falloff = 1.0 - texture(transitionTex, UV).r;

    // Extend the threshold slightly past both ends to guarantee a clean wipe.
    float remap = mix(-0.1, 1.1, threshold);
    falloff = step(falloff, remap);
    COLOR.a = falloff;
}
"

[resource]
resource_local_to_scene = true
shader = SubResource("Shader_neuvillette_transition")
shader_parameter/threshold = 0.0
shader_parameter/transitionTex = ExtResource("1_transition")
